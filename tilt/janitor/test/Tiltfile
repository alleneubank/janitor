# -*- mode: Python -*-
load('../Tiltfile', 'janitor_wrap', 'janitor_tilt_up_cmd')

def _expect(actual, expected, label):
    if actual != expected:
        fail('%s mismatch:\nactual: %s\nexpected: %s' % (label, actual, expected))

_expect(
    janitor_wrap('anvil --host 0.0.0.0', grace_ms=5000, watch_path='/work', janitor_bin='janitor'),
    ['janitor', '--watch-path', '/work', '--grace-ms', '5000', '--', 'sh', '-c', 'anvil --host 0.0.0.0'],
    'string command',
)

_expect(
    janitor_wrap(['anvil', '--host', '0.0.0.0'], grace_ms=5000, watch_path='/work', janitor_bin='janitor'),
    ['janitor', '--watch-path', '/work', '--grace-ms', '5000', '--', 'anvil', '--host', '0.0.0.0'],
    'list command',
)

_expect(
    janitor_wrap('x', grace_ms=250, watch_path='/work', janitor_bin='janitor')[3:5],
    ['--grace-ms', '250'],
    'custom grace',
)

# The outer-guard string shell-quotes the watch path so it is safe to paste
# into a Makefile/shell even with spaces or metacharacters (REQ-TILT-007).
_expect(
    janitor_tilt_up_cmd(grace_ms=5000, watch_path='/work'),
    "janitor --watch-path '/work' --grace-ms 5000 -- tilt up",
    'tilt up command',
)

_expect(
    janitor_tilt_up_cmd(grace_ms=5000, watch_path='/a b'),
    "janitor --watch-path '/a b' --grace-ms 5000 -- tilt up",
    'tilt up command quotes spaces',
)

_expect(
    janitor_tilt_up_cmd(grace_ms=5000, watch_path="/a'b"),
    "janitor --watch-path '/a'\\''b' --grace-ms 5000 -- tilt up",
    'tilt up command escapes single quote',
)

# Negative cases intentionally live outside this load-test (they fail at module
# load) and are covered by tilt/janitor/test/resolve_test.sh:
#  - JANITOR_AUTO_INSTALL=0 with janitor absent exits non-zero with the install
#    message;
#  - an explicit janitor_bin override never triggers auto-install.
